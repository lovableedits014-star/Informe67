# EasyPanel: use n8n_postgres:5432 when the backend shares its private network.
# Local development through the SSH tunnel: use 127.0.0.1 and port 5433.
PGHOST=n8n_postgres
PGPORT=5432
PGDATABASE=informe67
PGUSER=informe67_user
PGPASSWORD=
PGCONNECT_TIMEOUT_MS=5000

# Origin of the admin panel served by this API; HTTPS is required in production.
# Use this exact URL in your browser, including the port in local development.
ADMIN_ORIGIN=http://localhost:3000
# In production, allow the exact frontend origin for public news GET requests.
PUBLIC_SITE_ORIGIN=

# Optional: 32-byte encryption key encoded as 64 hex characters, set as a secret.
# When omitted, a random key is generated in backend/.private/ai.key.
# Persist that private directory in production; losing the key requires entering
# the provider API key again. Never expose either key to the public frontend.
AI_ENCRYPTION_KEY=
AI_SECRET_DIR=
