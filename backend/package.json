{
  "name": "informe67-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "site:dev": "node scripts/site-server.mjs",
    "dev": "node scripts/editor-assets.mjs && tsx watch src/server.ts",
    "build": "node scripts/editor-assets.mjs && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:inventory": "tsx scripts/inventory.ts",
    "db:preflight": "tsx scripts/preflight.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "news:permissions": "tsx scripts/news-permissions.ts",
    "categories:seed": "tsx scripts/seed-categories.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@mozilla/readability": "^0.6.0",
    "dotenv": "^18.0.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.2",
    "jsdom": "^30.1.2",
    "pg": "^8.23.1",
    "quill": "2.0.2",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.4"
    }
  }
}
